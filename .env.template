TELEGRAM_CHANNEL_ID_UR=@NationReportersUrdu
TELEGRAM_CHANNEL_ID_AR=@NationReportersArabic
TELEGRAM_CHANNEL_ID_FR=@NationReportersFrench
TELEGRAM_CHANNEL_ID_DE=@NationReportersGerman
TELEGRAM_CHANNEL_ID_ES=@NationReportersSpanish
TELEGRAM_CHANNEL_ID_PT=@NationReportersPortuguese
