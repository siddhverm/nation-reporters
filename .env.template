# Set to true to post only English articles to the main channel
TELEGRAM_ENGLISH_ONLY=false

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Feature Flags
FEATURE_AUTO_APPROVE=false
FEATURE_TTS=false

# Ingestion automation tuning
# Set true on VPS when Gemini quota is exhausted — skips AI; stories are held per RAW_FALLBACK_MODE (never publishes source text)
INGESTION_SKIP_AI=false
# Set on VPS, then: curl -X POST "http://127.0.0.1:3001/api/v1/ingestion/bootstrap-regional?key=YOUR_KEY&force=1"
INGESTION_BOOTSTRAP_KEY=
INGESTION_MAX_PER_CATEGORY=20
INGESTION_MAX_ITEMS_PER_SOURCE=28
INGESTION_MAX_FEED_ITEMS_SCAN=100

# Fetch full article HTML from each item link: runs at ingestion (stored body) and again in AI if still short.
# Accept-Language follows the source’s configured language (Indian + foreign RSS). Disable only for strict offline dev.
FETCH_SOURCE_ARTICLE=true
FETCH_SOURCE_TIMEOUT_MS=15000
FETCH_SOURCE_MAX_BYTES=1000000

# Country feed endpoint cache TTL
COUNTRY_FEED_CACHE_TTL_MS=120000
INGESTION_EXPECTED_INTERVAL_HOURS=10

# AI video generation worker
VIDEO_GENERATION_ENABLED=false
VIDEO_WORKER_BATCH_SIZE=5
VIDEO_RENDER_SECONDS=45
VIDEO_FFMPEG_PATH=ffmpeg

# Web push notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:legal@nationreporters.com

# --- Simple-language rewrite (all 23 languages) ---
# Reading level of generated stories: simple (default) | plain | standard | advanced
READING_LEVEL=simple
REWRITE_MAX_LONG_WORDS=700
# Gemini attempts per story (stricter retry prompt when output is too similar to the source / drops numbers). 1-4
REWRITE_MAX_ATTEMPTS=2
# Copy-safety gate: max share of output word 5-grams found in the source, longest allowed verbatim run (words / CJK chars)
REWRITE_MAX_OVERLAP=0.25
REWRITE_MAX_COPIED_RUN_WORDS=12
REWRITE_MAX_COPIED_RUN_CHARS=36
# Share of source numbers (2+ digits) that must survive in the rewrite; below this the story goes to PENDING_REVIEW
REWRITE_MIN_NUMBER_RETENTION=0.6
# When the rewrite fails or AI quota is exhausted: draft (default, hold as DRAFT) | placeholder (publish a neutral placeholder; never source text)
RAW_FALLBACK_MODE=draft
RAW_FALLBACK_MAX_DRAFTS_PER_RUN=30

# Web (runtime env of the Next.js app): contact shown on /copyright
COPYRIGHT_EMAIL=
