# App
NODE_ENV=development
PORT=3001
# Public site origin used in social posts (article link + /story-image/<slug> picture). MUST be the live domain in production.
PUBLIC_WEB_BASE_URL=https://nationreporters.com

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
MFA_ISSUER=NationReporters

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nationreporters

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage for story pictures (mirrored source images + AI-generated ones). REQUIRED for any real picture:
# without it every story shows generated fallback artwork. Local dev: MinIO on localhost:9000.
# Production (docker-compose.server.yml): start the bundled MinIO with `docker compose -f docker-compose.server.yml --profile storage up -d minio minio-init`
# and set S3_ENDPOINT=http://minio:9000 (the API proxies images; the bucket stays private) — or point at any S3 endpoint.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nation-reporters
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# AI
GEMINI_API_KEY=
# Text model (rewrite, tags, SEO, translation). On a 404 / "no longer available" the API switches to the next
# fallback automatically and logs "Gemini text: using model …". Pick ids your key lists in ListModels.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.5-flash-lite
# Story pictures. IMAGE_MODE:
#   source_first   (default) mirror the source item's image into OUR storage (SSRF-safe fetch, type/size/min-dimension
#                  validation, EXIF stripped, never hotlinked) and show it with the small copyright note; fall back to an
#                  AI-generated picture when the source image is missing/broken/too small. Needs S3_*.
#   generated_only (safe mode) never fetch a source image; every story gets an AI-generated picture / fallback artwork.
# The public URL is always our own /story-image/<slug>; no source domain/URL is ever exposed.
IMAGE_MODE=source_first
# Source-image validation (source_first only)
SOURCE_IMAGE_MAX_BYTES=5000000
SOURCE_IMAGE_MIN_WIDTH=600
SOURCE_IMAGE_MIN_HEIGHT=315
SOURCE_IMAGE_MAX_PIXELS=50000000
SOURCE_IMAGE_TIMEOUT_MS=15000
# Storage upload retries (a failed upload is retried, never silently replaced by a generated picture)
S3_PUT_RETRIES=3
S3_RETRY_BASE_MS=500
# AI-generated pictures (used when there is no usable source image, or in generated_only mode).
# Needs GEMINI_API_KEY + S3_* above. Without them the story shows generated fallback artwork.
IMAGE_GEN_ENABLED=true
# Image model; on a 404 the next IMAGE_GEN_MODEL_FALLBACKS entry is used (logged once as "Gemini image: using model …").
IMAGE_GEN_MODEL=gemini-2.5-flash-image
IMAGE_GEN_MODEL_FALLBACKS=gemini-3.1-flash-image
IMAGE_GEN_TIMEOUT_MS=40000
IMAGE_GEN_MIN_INTERVAL_MS=4000

# Email
RESEND_API_KEY=

# Social Platforms
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CHANNEL_ID=
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb7pi0EDDmFaBk8Bs345

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@NationReportersNews
TELEGRAM_CHANNEL_ID_HI=@NationReportersHindi
TELEGRAM_CHANNEL_ID_BN=@NationReportersBengali
TELEGRAM_CHANNEL_ID_MR=@NationReportersMarathi
TELEGRAM_CHANNEL_ID_TA=@NationReportersTamil
